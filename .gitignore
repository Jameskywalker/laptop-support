.venv/
__pycache__/
*.pyc
# 中间结果（可由脚本重新生成）
out/**/coarse_nojoint/
out/raised25/fine_nonrobust/
out/**/profile.pkl
# 三维优化试验的输出（体积大、可由 topopt3d.py / export3d.py / make_web3d.py 重新生成）
out/**/topo3d/
out/**/model3d/
web/support3d_preview.html
# 无填充三维优化的输出（同上，可由 topopt3d_noinfill.py / export3d_noinfill.py / make_web_noinfill.py 重新生成）
out/**/noinfill*/
out/**/model_noinfill*/
out/**/noinfill*.log
out/**/model_noinfill*.log
web/noinfill*_preview.html
web/panel_contact_preview.html
# 面板 / 后横梁接触优化：复核应力场（可由 --post_only 重新生成）；后横梁的试验结果没有采用
out/**/*_contact/fields.npz
out/**/beam_contact/
# 远程跑完的标记、零散日志
out/**/run_done*.txt
out/*_rerun.log
# 插指 + U 形卡子试验：STL / STEP 可由 clip_trial.py --skip_fe 重新生成
out/**/clip_trial/*.stl
out/**/clip_trial/*.step
